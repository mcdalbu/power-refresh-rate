[Unit]
Description=LPMD workload EPP tables by power profile and AC/battery
Wants=power-profiles-daemon.service upower.service intel_lpmd.service
After=dbus.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 -I /usr/local/libexec/power-profile-lpmd.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/etc/intel_lpmd
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
